---
import Layout from "../layouts/Layout.astro";
import GitHubButton from "../components/githubButton.astro";
---

<Layout>
	<header
		class="mx-auto flex max-w-7xl items-center justify-between px-5 py-5 sm:px-8 lg:px-12"
		id="top"
	>
		<a href="#top" aria-label="Junk Drawer home">
			<span class="text-xl font-thin tracking-[-0.03em] text-white/90"
				>Junk Drawer</span
			>
		</a>
		<div class="flex items-center gap-2">
			<GitHubButton user="aym-kh" repo="junk_drawer" />
			<a
				href="https://x.com/__aymkh/status/2109820366415679776"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="View the original post on X"
				title="View the original post on X"
				class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-neutral-800 bg-neutral-900 text-white shadow-sm transition-colors hover:bg-neutral-800 focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
			>
				<svg
					class="h-4 w-4 fill-current"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						d="M18.901 1.153h3.68L14.54 10.01l9.47 12.837h-7.406l-5.8-7.584-6.637 7.584h-3.68l8.6-9.713L0 1.153h7.594l5.243 6.932zm-1.29 19.43h2.039L6.486 3.298H4.298z"
					></path>
				</svg>
			</a>
		</div>
		<a
			class="rounded-full border border-white/15 px-3.5 py-2 text-xs font-medium text-white/80 transition hover:border-white/35 sm:hidden"
			href="#download">Get the app</a
		>
	</header>

	<main id="top">
		<section
			class="relative isolate mx-auto grid max-w-7xl items-center gap-8 px-5 pb-16 pt-10 sm:px-8 sm:pb-20 sm:pt-14 lg:min-h-155 lg:grid-cols-[0.9fr_1.1fr] lg:gap-0 lg:px-12 lg:pb-24 lg:pt-10"
		>
			<div
				class="grid-glow pointer-events-none absolute inset-x-0 top-0 -z-10 h-3/4 opacity-40"
			>
			</div>
			<div class="relative z-10 max-w-xl space-y-8">
				<h1
					class="max-w-155 text-[clamp(3.15rem,7.7vw,6.8rem)] leading-[0.91] font-extrabold tracking-[-0.085em] text-white"
				>
					STASH YOUR<br />
					DESKTOP CHAOS<br />
					<span class="text-white/38">INSTANTLY.</span>
				</h1>
				<div class="flex flex-col items-start gap-3">
					<p
						class="font-mono text-[10px] tracking-wide text-white/35"
					>
						ctrl + shift + d to stash your desktop clutter
						<br />
						cmd + shift + d on macOS
					</p>
					<a
						href="https://github.com/aym-kh/junk_drawer/releases"
						class="items-center justify-center rounded-lg bg-white px-6 py-4 font-thin text-[#0a0a0b] transition hover:-translate-y-0.5 hover:bg-[#e9e9e7]"
						target="_blank"
					>
						Download for free
					</a>
				</div>
			</div>

			<div
				class="relative mx-auto mt-2 w-full max-w-170 lg:mt-0 lg:translate-x-5"
			>
				<div
					class="pointer-events-none absolute inset-x-10 top-10 -z-10 aspect-square rounded-full bg-white/[0.035] blur-3xl"
				>
				</div>
				<img
					src="/hero.webp"
					alt="A tidy digital drawer resting on a laptop keyboard, with files tucked inside"
					class="hero-art float-art relative z-0 mx-auto w-full"
					width="760"
					height="650"
					fetchpriority="high"
				/>
			</div>
		</section>
	</main>

	<footer
		class="mx-auto max-w-7xl border-t border-white/[0.07] px-5 py-6 sm:px-8 lg:px-12"
	>
		<div
			class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between"
		>
			<div class="flex items-center gap-4">
				<p class="font-mono text-[9px] tracking-wide text-white/35">
					© 2026 Junk Drawer
				</p>
				<a
					class="text-[10px] text-white/40 transition hover:text-white/75"
					href="https://aymkh.tn"
					target="_blank"
					rel="noreferrer"
					>Developed by AymKh<span aria-hidden="true">↗</span></a
				>
			</div>

			<p id="privacy" class="text-[9px] leading-5 text-white/30">
				Privacy: This landing page does not collect personal data or use
				tracking cookies.
			</p>
		</div>
	</footer>
</Layout>
